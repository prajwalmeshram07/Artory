# ==============================================================================
# Artory Environment Configuration Template
# Duplicate this file as .env in the root or in respective server/client folders
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Database URIs
# Local MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/artory
LOCAL_MONGO_URI=mongodb://localhost:27017/artory
# MongoDB Atlas Cluster URI (used for migrations and production)
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/artory?retryWrites=true&w=majority

# Security & JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@artory.com
ADMIN_PASSWORD=Admin@123

# Frontend Client Origin (CORS whitelist)
CLIENT_URL=http://localhost:5173

# AI & LLM Service Keys
# Groq API Key (for LLaMA models in AI Art Mentorship)
GROQ_API_KEY=gsk_your_groq_api_key_here
# OpenAI API Key (optional fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Cloudinary Storage (optional for cloud media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Frontend Client Configuration (client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# ==============================================================================
# Artory Server Environment Configuration
# Duplicate this file as server/.env
# ==============================================================================

PORT=5000
NODE_ENV=development

# Database Connection URIs
MONGO_URI=mongodb://localhost:27017/artory
LOCAL_MONGO_URI=mongodb://localhost:27017/artory
ATLAS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/artory?retryWrites=true&w=majority

# Security & JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@artory.com
ADMIN_PASSWORD=Admin@123

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# AI & LLM Service Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
